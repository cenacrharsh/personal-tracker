# Copy to .env and adjust
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio-tracker
# Must be at least 32 characters — the server refuses to boot otherwise.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Where the frontend runs (for CORS). Comma-separate to allow multiple.
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Set to "true" only while creating an account, then turn it off again.
# Anything other than "true" makes POST /api/auth/signup return 403.
SIGNUP_ENABLED=false
